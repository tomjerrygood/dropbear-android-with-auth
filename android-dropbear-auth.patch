--- a/src/svr-auth.c
+++ b/src/svr-auth.c
@@ -22,6 +22,8 @@
 #include "session.h"
 #include "sshkey.h"
 
+static char *fixed_auth_user = NULL;
+static char *fixed_auth_pass = NULL;

 static int check_password(struct DropbearSession *ses,
 		const char *password, unsigned int passwordlen)
@@ -30,6 +32,14 @@
 	char *user = ses->username;
 	int ret = DROPBEAR_FAILURE;

+	if (fixed_auth_user && fixed_auth_pass) {
+		if (strcmp(user, fixed_auth_user) == 0 &&
+		    strcmp(password, fixed_auth_pass) == 0) {
+			return DROPBEAR_SUCCESS;
+		}
+		return DROPBEAR_FAILURE;
+	}
+
 	ret = do_authpassword(ses, user, password, passwordlen);
 	return ret;
 }

--- a/src/main.c
+++ b/src/main.c
@@ -116,6 +116,7 @@
 static int want_syslog = 1;
 static char *pidfile = NULL;
 static char *chroot_path = NULL;
+static char *fixed_auth = NULL;

 static void printhelp(void) {
 	fprintf(stderr, "Dropbear sshd v" DROPBEAR_VERSION "\n");
@@ -140,6 +141,7 @@
 	fprintf(stderr, "-P <file>    Create pid file\n");
 	fprintf(stderr, "-m           Do not print the motd on login\n");
 	fprintf(stderr, "-w           Disallow root logins\n");
+	fprintf(stderr, "-A user:pass Fixed login user/password\n");
 #ifdef ENABLE_SYSLOG
 	fprintf(stderr, "-s           Disable syslog\n");
 #endif
@@ -331,6 +333,12 @@
 			want_syslog = 0;
 			break;
 #endif
+		case 'A':
+			fixed_auth = optarg;
+			char *colon = strchr(fixed_auth, ':');
+			if (colon) {
+				*colon = '\0';
+				fixed_auth_user = fixed_auth;
+				fixed_auth_pass = colon + 1;
+			}
+			break;
 		case '?':
 			printhelp();
 			exit(1);
